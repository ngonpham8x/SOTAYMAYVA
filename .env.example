# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Private web/PWA login configuration. Configure only in Vercel Environment Variables.
# Add one email/password pair for each permitted person (up to three pairs supported).
APP_LOGIN_EMAIL_1=""
APP_LOGIN_PASSWORD_1=""
APP_LOGIN_EMAIL_2=""
APP_LOGIN_PASSWORD_2=""
# Optional alternative for managed accounts: a JSON object mapping email to password.
APP_LOGIN_ACCOUNTS=""
# A random secret with at least 32 characters for signed login sessions.
APP_SESSION_SECRET=""
# Private daily-backup configuration. Set these values only in Vercel's
# Environment Variables (or a local .env file that is never committed).
# Separate multiple private recipients with a comma or semicolon.
BACKUP_TARGET_EMAILS=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# A private Vercel Blob store holds the newest encrypted recovery snapshot.
BLOB_READ_WRITE_TOKEN=""

# At least 16 random characters. Vercel uses it to authenticate the daily cron.
CRON_SECRET=""
